__pycache__/
*.pyc
.venv/
venv/
*.pt
runs/
data/
*.log
visionaid_pt/

# Deployment weights, exports and verification artifacts
*.pth
*.onnx
*.engine
*_openvino_model/
.pytest_cache/
artifacts/
.env
# Per-camera focal length from scripts/calibrate_distance.py
camera_calibration.json

# Personal videos stay local. The credited demo clips are allowed below.
demo/videos/*
*.mp4
*.mov
*.MOV
*.webm
*.avi

# Vercel photo-check function ships its ONNX model (12 MB); allow it past the *.onnx rule
!deploy/vercel/model/*.onnx
# Default local detector: INT8 export (3.5 MB), shipped so a fresh clone runs without copying weights
!models/local/yolov8n_v4_four_class_int8.onnx
!models/general/yolov8n_int8.onnx
# Redistributable motion demos, credited in demo/README.md
!demo/challenges/VivoCity - escalator atrium.mp4
!demo/videos/* - field sequence.mp4
!demo/videos/Passengers descending the central staircase.mp4
!demo/videos/People passing through a shared space.mp4
!demo/videos/Following a commuter down the escalator.mp4
!demo/videos/Walk to the subway stairs.mp4
